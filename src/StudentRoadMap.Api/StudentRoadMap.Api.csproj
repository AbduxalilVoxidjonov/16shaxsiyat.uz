<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\StudentRoadMap.Application\StudentRoadMap.Application.csproj" />
    <ProjectReference Include="..\StudentRoadMap.Infrastructure\StudentRoadMap.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Superadmin JWT (Bearer) autentifikatsiyasi — `docs/08` 2-bo'lim. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- `dotnet ef` vositalari uchun — startup loyiha bu paketni bevosita ko'rsatishi shart
         (Infrastructure'dagi PrivateAssets="all" transitiv o'tmaydi). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
