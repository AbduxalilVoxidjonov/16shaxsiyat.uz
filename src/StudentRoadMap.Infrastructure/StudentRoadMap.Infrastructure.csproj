<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Eslatma: Npgsql.EntityFrameworkCore.PostgreSQL hali net10.0/EF Core 10 uchun barqaror
    versiya chiqarmagan (faqat net11 preview mavjud) — shu sabab EF Core 9.x paketlari
    aniq versiya bilan qulflangan. net10.0 loyihasi net9.0 kutubxonalarini muammosiz
    ishlatadi (forward TFM moslik). EF Core 10 chiqishi bilan yangilanadi.
  -->

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudentRoadMap.Application\StudentRoadMap.Application.csproj" />
  </ItemGroup>

  <!-- `Pbkdf2PasswordHasher` (va boshqa `internal` sinflar) faqat sinov sborkasiga ochiladi —
       ochiq (public) API sirtini kengaytirmasdan to'g'ridan-to'g'ri unit-test qilish uchun. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StudentRoadMap.Infrastructure.Tests" />
  </ItemGroup>

  <!-- Seed JSON'lari (test bankiga tegishli — 4 metodika, tip katalogi, kasb xaritasi) chiqish
       katalogiga ko'chiriladi (`DbSeeder` `AppContext.BaseDirectory/SeedData` dan o'qiydi). -->
  <ItemGroup>
    <!-- `Link` chiqish katalogidagi joyni "SeedData/..." ga tekislaydi (manba yo'li
         "Persistence/SeedData/..." bo'lsagsa ham) — `DbSeeder` shu yo'ldan o'qiydi. -->
    <Content Include="Persistence\SeedData\**\*.json">
      <Link>SeedData\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
