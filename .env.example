# Shaxsiyat (StudentRoadMap) — muhit o'zgaruvchilari namunasi.
# Nusxa oling: `cp .env.example .env` va haqiqiy qiymatlar bilan to'ldiring.
# Bu fayl repo'ga qiymatlar bilan COMMIT QILINMAYDI — faqat namuna (`CLAUDE.md` 4-qoida).

# --- PostgreSQL (docker-compose "db" servisi) ------------------------------------------
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Baza host'da qaysi portda ko'rinadi (faqat 127.0.0.1). Standart 5433 — 5432 ni shu
# mashinadagi boshqa loyihaning Postgres'i egallab turishi mumkin (aynan shu sabab stek
# bir marta "port is already allocated" bilan ko'tarilmagan). Konteynerlararo aloqaga
# ta'sir qilmaydi — ular `Host=db;Port=5432` ishlatadi.
DB_PORT=5433

# --- Api (docker-compose "api" servisi / lokal `dotnet run` uchun user-secrets) --------
# Lokal ishlab chiqishda (Docker'siz) buning o'rniga:
#   dotnet user-secrets set "ConnectionStrings:Postgres" "Host=localhost;Port=5432;Database=studentroadmap;Username=srm;Password=${DB_PASSWORD}" -p src/StudentRoadMap.Api
ConnectionStrings__Postgres=Host=db;Database=studentroadmap;Username=srm;Password=CHANGE_ME_STRONG_PASSWORD

# JWT — kamida 32 bayt tasodifiy matn (masalan: `openssl rand -base64 48`).
Jwt__Key=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET

# AI provayder kaliti va TOTP sirini shifrlash uchun AES-256 kaliti — aynan 32 bayt, base64.
# Generatsiya: `openssl rand -base64 32`
Security__EncryptionKey=CHANGE_ME_32_BYTE_BASE64_KEY

# IP manzillarni xeshlash uchun tuz (audit/rate-limit, IP xom holda saqlanmaydi).
Security__IpHashSalt=CHANGE_ME_RANDOM_SALT

# --- Telegram orqali kirish (ommaviy foydalanuvchi, P47) ------------------------------
# Telegram bot tokeni — @BotFather bergan `123456789:AA...` ko'rinishidagi SIR.
# Faqat imzoni tekshirish uchun ishlatiladi (`SHA256(bot_token)` = HMAC maxfiy kaliti),
# hech qanday Telegram API chaqirig'i yuborilmaydi va token log/DB'ga tushmaydi.
#
# Sozlash (bir marta, loyiha egasi):
#   1. @BotFather → /newbot → bot nomi va username (masalan `shaxsiyat_login_bot`);
#   2. @BotFather → /setdomain → shu bot uchun `16shaxsiyat.uz` domenini biriktiring
#      (Login Widget FAQAT biriktirilgan domendan ishlaydi);
#   3. olingan tokenni shu yerga yozing.
#
# BO'SH qoldirilsa Telegram kirishi O'CHIQ bo'ladi: `POST /api/auth/telegram`
# `503 TELEGRAM_AUTH_NOT_CONFIGURED` qaytaradi, ilovaning qolgan qismi normal ishlaydi.
Telegram__BotToken=

# --- Natijani foydalanuvchiga ko'rsatish ----------------------------------------------
# GLOBAL avariya rubilnigi (kill-switch). Standart **`true`** (P47): haqiqiy qaror endi
# MAKON darajasida (`schools.show_result_to_student` — maktab uchun `false`, ommaviy makon
# uchun `true`), bu bayroq esa ikkalasini `&&` bilan yopadi. `false` — huquqiy talab yoki
# insident holatida BUTUN tizimda (maktab ham, ommaviy makon ham) natijani darhol yopish.
App__ShowResultToStudent=true

# Ishonchli reverse-proksi(lar) ro'yxati — vergul bilan ajratilgan IP yoki `IP/prefix` (CIDR)
# ro'yxati (masalan: `172.20.0.5,10.0.0.0/24`). Faqat shu manzillardan kelgan `X-Forwarded-For`/
# `X-Forwarded-Proto` header'iga ishoniladi (`ForwardedHeadersSetup`, `docs/13` 4-bo'lim: Caddy
# `api` konteynerining docker-tarmoq IP'si). BO'SH bo'lsa (lokalda standart) header'ga umuman
# ISHONILMAYDI — spoofing himoyasi (CLAUDE.md 8/9-band ruhida: proksisiz muhitda haqiqiy TCP
# ulanish manzili ishlatiladi).
App__KnownProxies=

# Frontend manzili (CORS va havolalar uchun).
App__FrontendUrl=http://localhost:5173
FRONTEND_URL=https://16shaxsiyat.uz

# Superadmin (yagona) — `DbSeeder` shu ikkitasi bo'lmasa superadminni yaratmaydi (`docs/05` 4-bo'lim).
# Parol xeshlanadi, kodda/JSON'da hech qachon saqlanmaydi (`CLAUDE.md` 4-qoida).
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=CHANGE_ME_admin@16shaxsiyat.uz

# Ilova birinchi ishga tushganda seed'ni avtomatik bajarish (idempotent, `DbSeeder`).
# Production'da odatda `false` — seed alohida `--seed` bosqichi bilan bajariladi.
App__SeedOnStartup=false

# --- AI tahlili -----------------------------------------------------------------------
# O'quvchi sessiyani YAKUNLAGANDA AI tahlili avtomatik navbatga qo'yiladimi.
#
# Standart **`false`** (2026-09-03, loyiha EGASI qarori — `docs/06` 8-bo'lim qarorlar
# jurnali): har bir tahlil AI provayderiga to'lanadigan XARAJAT, shuning uchun qaysi
# o'quvchi tahlil qilinishini superadmin admin panelidagi "AI tahlil qilish" tugmasi
# (`POST /api/admin/assessments/{id}/rerun-analysis`) orqali O'ZI tanlaydi.
#
# `false` bo'lganda sessiya yakunlanadi va ballar/`TestResult`/ishonchlilik/`StudentSnapshot`
# avvalgidek hisoblanadi — faqat sessiya `Analyzing`ga o'tmaydi va navbatga hech narsa
# qo'yilmaydi (holat `Completed` bo'lib qoladi).
#
# Qo'lda ishga tushirish bu bayroqdan MUSTAQIL — tugma har doim ishlaydi.
# Avtomatik oqimni qaytarish uchun: `true` (qayta deploy kifoya, kod o'zgarmaydi).
Ai__AutoAnalyzeOnCompletion=false

# --- Web (docker-compose "web" servisi, keyingi promptlarda) ---------------------------
API_URL=https://api.16shaxsiyat.uz

# Cloudflare tunnel tokeni (Zero Trust > Tunnels > tunnel > Install connector).
TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# Ilova qaysi portda ochiladi (docker compose "app" servisi).
WEB_PORT=8080

# Docker compose tarmog'ining subneti — `app` (nginx) ishonchli proksi deb belgilanadi.
# Usiz `X-Forwarded-For` e'tiborsiz qoladi va rate limiting hamda IP audit bitta
# manzilga yig'ilib qoladi (P10 QA topilmasi). `docker-compose.yml` faylida shu subnet
# QAT'IY belgilangan (`networks.default.ipam.config.subnet`) — shuning uchun quyidagi
# standart qiymat tarmoq qayta yaratilganda ham O'ZGARMAYDI (`docs/13` MAXSUS DIQQAT).
# Agar `docker-compose.yml` dagi subnet qo'lda o'zgartirilsa, shu qatorni ham moslang.
# Tekshirish (nomuvofiqlik bo'lmasligi uchun): quyidagi ikkalasi bir xil bo'lishi shart —
#   docker network inspect 16shaxsiyat_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   grep -A2 "subnet:" docker-compose.yml
App__KnownProxies=172.26.0.0/16

# --- E2E testlar (P30, `docker-compose.e2e.yml`) ---------------------------------------
# Playwright to'plami JONLI stekka (`16shaxsiyat.uz`) TEGMAYDI: `frontend/e2e/global-setup.ts`
# alohida compose loyihasini (`shaxsiyat-e2e`) va HAR RUN uchun yangi bo'sh bazani ko'taradi.
# DB paroli, `Jwt__Key` va `Security__EncryptionKey` har run uchun avtomatik generatsiya
# qilinadi — ularni bu yerda berish SHART EMAS.
#
# Faqat superadmin login/parol kerak: shu qiymatlar bilan E2E bazasiga superadmin seed
# qilinadi va admin oqimi testlari shu bilan kiradi. Parol KODDA saqlanmaydi (CLAUDE.md
# 4-qoida) — bu yerda yoki CI sirlarida (`secrets.E2E_ADMIN_*`) beriladi. Jonli
# `ADMIN_PASSWORD` dan FARQLI bo'lsin: E2E bazasi bir martalik va butunlay ajratilgan.
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=CHANGE_ME_E2E_ONLY_PASSWORD

# Ixtiyoriy: portlar band bo'lsa o'zgartiring (standart 5199 / 5081).
# E2E_WEB_PORT=5199
# E2E_API_PORT=5081
#
# Ixtiyoriy nosozlik bayroqlari:
#   E2E_KEEP_STACK=1    — testdan keyin stek o'chirilmaydi (loglarni ko'rish uchun)
#   E2E_REUSE_STACK=1   — stek qayta ko'tarilmaydi (ishlab turgani ishlatiladi, tezroq)
#   E2E_DEBUG_API=1     — muvaffaqiyatsiz API javoblari (tana bilan) stdout'ga chiqadi
#   E2E_A11Y_REPORT=1   — axe/tartib/konsol topilmalari testni yiqitmasdan ro'yxatlanadi
