# Shaxsiyat (StudentRoadMap) — muhit o'zgaruvchilari namunasi.
# Nusxa oling: `cp .env.example .env` va haqiqiy qiymatlar bilan to'ldiring.
# Bu fayl repo'ga qiymatlar bilan COMMIT QILINMAYDI — faqat namuna (`CLAUDE.md` 4-qoida).

# --- PostgreSQL (docker-compose "db" servisi) ------------------------------------------
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Api (docker-compose "api" servisi / lokal `dotnet run` uchun user-secrets) --------
# Lokal ishlab chiqishda (Docker'siz) buning o'rniga:
#   dotnet user-secrets set "ConnectionStrings:Postgres" "Host=localhost;Port=5432;Database=studentroadmap;Username=srm;Password=${DB_PASSWORD}" -p src/StudentRoadMap.Api
ConnectionStrings__Postgres=Host=db;Database=studentroadmap;Username=srm;Password=CHANGE_ME_STRONG_PASSWORD

# JWT — kamida 32 bayt tasodifiy matn (masalan: `openssl rand -base64 48`).
Jwt__Key=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM_SECRET

# AI provayder kaliti va TOTP sirini shifrlash uchun AES-256 kaliti — aynan 32 bayt, base64.
# Generatsiya: `openssl rand -base64 32`
Security__EncryptionKey=CHANGE_ME_32_BYTE_BASE64_KEY

# IP manzillarni xeshlash uchun tuz (audit/rate-limit, IP xom holda saqlanmaydi).
Security__IpHashSalt=CHANGE_ME_RANDOM_SALT

# Ishonchli reverse-proksi(lar) ro'yxati — vergul bilan ajratilgan IP yoki `IP/prefix` (CIDR)
# ro'yxati (masalan: `172.20.0.5,10.0.0.0/24`). Faqat shu manzillardan kelgan `X-Forwarded-For`/
# `X-Forwarded-Proto` header'iga ishoniladi (`ForwardedHeadersSetup`, `docs/13` 4-bo'lim: Caddy
# `api` konteynerining docker-tarmoq IP'si). BO'SH bo'lsa (lokalda standart) header'ga umuman
# ISHONILMAYDI — spoofing himoyasi (CLAUDE.md 8/9-band ruhida: proksisiz muhitda haqiqiy TCP
# ulanish manzili ishlatiladi).
App__KnownProxies=

# Frontend manzili (CORS va havolalar uchun).
App__FrontendUrl=http://localhost:5173
FRONTEND_URL=https://16shaxsiyat.uz

# Superadmin (yagona) — `DbSeeder` shu ikkitasi bo'lmasa superadminni yaratmaydi (`docs/05` 4-bo'lim).
# Parol xeshlanadi, kodda/JSON'da hech qachon saqlanmaydi (`CLAUDE.md` 4-qoida).
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=CHANGE_ME_admin@16shaxsiyat.uz

# Ilova birinchi ishga tushganda seed'ni avtomatik bajarish (idempotent, `DbSeeder`).
# Production'da odatda `false` — seed alohida `--seed` bosqichi bilan bajariladi.
App__SeedOnStartup=false

# --- Web (docker-compose "web" servisi, keyingi promptlarda) ---------------------------
API_URL=https://api.16shaxsiyat.uz

# Cloudflare tunnel tokeni (Zero Trust > Tunnels > tunnel > Install connector).
TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# Ilova qaysi portda ochiladi (docker compose "app" servisi).
WEB_PORT=8080

# Docker compose tarmog'ining subneti — `app` (nginx) ishonchli proksi deb belgilanadi.
# Usiz `X-Forwarded-For` e'tiborsiz qoladi va rate limiting hamda IP audit bitta
# manzilga yig'ilib qoladi (P10 QA topilmasi). `docker-compose.yml` faylida shu subnet
# QAT'IY belgilangan (`networks.default.ipam.config.subnet`) — shuning uchun quyidagi
# standart qiymat tarmoq qayta yaratilganda ham O'ZGARMAYDI (`docs/13` MAXSUS DIQQAT).
# Agar `docker-compose.yml` dagi subnet qo'lda o'zgartirilsa, shu qatorni ham moslang.
# Tekshirish (nomuvofiqlik bo'lmasligi uchun): quyidagi ikkalasi bir xil bo'lishi shart —
#   docker network inspect 16shaxsiyat_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   grep -A2 "subnet:" docker-compose.yml
App__KnownProxies=172.26.0.0/16
