# Shaxsiyat (StudentRoadMap) — muhit o'zgaruvchilari namunasi (PRODUCTION SERVER uchun).
#
#   cp .env.example .env && chmod 600 .env     # so'ng BARCHA CHANGE_ME qiymatlarni almashtiring
#
# Bu faylda faqat PLACEHOLDER'lar — haqiqiy sir hech qachon repo'ga yozilmaydi (`CLAUDE.md`
# 4-qoida). `.env` o'zi `.gitignore` da. Server bo'yicha to'liq yo'riqnoma: `docs/13` §13.
#
# Sirlarni generatsiya qilish (har biri ALOHIDA, qayta ishlatilmasin):
#   DB_PASSWORD              openssl rand -hex 24          (hex — maxsus belgisiz, connection
#                                                           string va shell'da qochirish shart emas)
#   Jwt__Key                 openssl rand -base64 48
#   Security__EncryptionKey  openssl rand -base64 32       (AYNAN 32 bayt)
#   Security__IpHashSalt     openssl rand -base64 32
#   ADMIN_PASSWORD           openssl rand -base64 18       (yoki parol menejeri)
#
# DIQQAT — lokal bazani serverga KO'CHIRAYOTGAN bo'lsangiz (`docs/13` §13.4 B-yo'l):
# `Security__EncryptionKey` ni lokal `.env` dagi bilan AYNAN BIR XIL qiling. Bazadagi AI
# provayder kalitlari va TOTP sirlari shu kalit bilan shifrlangan — yangi kalit bilan ular
# o'qilmaydi (AI tahlili va 2FA kirishi ishlamay qoladi). `Security__IpHashSalt` ham bir xil
# bo'lsin (aks holda eski IP xeshlari yangilari bilan solishtirilmaydi). `Jwt__Key`,
# `DB_PASSWORD` esa yangi bo'lishi mumkin (faqat barcha sessiyalar qayta login qiladi).

# --- PostgreSQL (`db` servisi) ----------------------------------------------------------
# `docker-compose.yml` connection string'ni SHU qiymatdan o'zi yig'adi (`Host=db;...`).
# DIQQAT: parol faqat BIRINCHI marta (bo'sh `pgdata` volume'da) o'rnatiladi — keyin bu
# qatorni o'zgartirish bazadagi parolni O'ZGARTIRMAYDI (`ALTER USER srm PASSWORD ...` kerak).
DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Baza host'da qaysi portda ko'rinadi — FAQAT 127.0.0.1 (tashqi tarmoqqa yopiq). Standart 5433.
# Konteynerlararo aloqaga ta'sir qilmaydi (ular `Host=db;Port=5432` ishlatadi).
DB_PORT=5433

# Ma'lumot uchun: compose uni `api`/`migrate`/`seed` uchun `DB_PASSWORD` dan O'ZI yig'adi,
# shu qator konteynerlarga O'TMAYDI. Faqat Docker'siz `dotnet run` (user-secrets o'rniga)
# yoki qo'lda `psql` uchun namuna sifatida saqlangan.
ConnectionStrings__Postgres=Host=db;Port=5432;Database=studentroadmap;Username=srm;Password=CHANGE_ME_same_as_DB_PASSWORD

# --- API sirlari (`api`/`migrate`/`seed`) -----------------------------------------------
# JWT imzo kaliti — kamida 32 bayt. Almashtirilsa barcha login sessiyalari bekor bo'ladi.
Jwt__Key=CHANGE_ME_openssl_rand_base64_48

# AES-256 kaliti — AI provayder kalitlari va TOTP sirini shifrlaydi. AYNAN 32 bayt, base64.
# YO'QOTILMASIN: yo'qolsa bazadagi shifrlangan qiymatlar tiklanmaydi (qayta kiritiladi).
Security__EncryptionKey=CHANGE_ME_openssl_rand_base64_32

# IP manzillarni xeshlash tuzi (audit/rate-limit — IP xom holda saqlanmaydi).
Security__IpHashSalt=CHANGE_ME_openssl_rand_base64_32

# --- Proksi va domen --------------------------------------------------------------------
# Ishonchli reverse-proksi(lar): faqat shu manzillardan kelgan `X-Forwarded-For`/`-Proto`
# ga ishoniladi (`ForwardedHeadersSetup`). Qiymat = `docker-compose.yml` dagi
# `networks.default.ipam.config.subnet` (cloudflared va nginx shu tarmoqda) — `docs/13` §7.
# Tavsiya: bu qatorni BERMANG — compose uni `COMPOSE_SUBNET` dan oladi (ikkalasi doim mos).
# Tekshirish (ikkalasi bir xil chiqishi SHART):
#   docker network inspect 16shaxsiyat_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
#   grep -A2 "subnet:" docker-compose.yml
# App__KnownProxies=172.26.0.0/16

# Docker compose tarmog'i subneti (qat'iy — tarmoq qayta yaratilsa ham o'zgarmaydi). Serverda
# band bo'lsa (`docker network inspect $(docker network ls -q) | grep Subnet`) bo'sh diapazonni
# bering, masalan `172.30.0.0/16`. O'zgartirilsa: `docker compose down` (-v SIZ!) + `up -d`.
COMPOSE_SUBNET=172.26.0.0/16

# Ommaviy sayt manzili — maktab havolalari (`{FrontendUrl}/t/{slug}?k=...`) va CORS origin'i.
# Oxirida `/` YO'Q. Lokal sinovda (tunnelsiz): http://127.0.0.1:8090
App__FrontendUrl=https://16shaxsiyat.uz

# --- Superadmin (yagona) — `seed` (`--profile init`) shu qiymatlardan yaratadi ---------
# Seed superadminni USERNAME bo'yicha tekshiradi: shu username bazada bo'lsa — tegmaydi
# (parol ham o'zgarmaydi); BOSHQA username bo'lsa — IKKINCHI superadmin yaratadi. Shu sabab
# lokal baza ko'chirilgan serverda seed ishlatilmaydi (yoki username lokal bilan bir xil).
# Parol faqat xesh holida saqlanadi; birinchi kirishdan keyin panelda almashtiring.
ADMIN_USERNAME=CHANGE_ME_admin_username
ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_18
ADMIN_EMAIL=admin@16shaxsiyat.uz

# `api` ishga tushganda seed bajarilsinmi. `docker-compose.yml` uni `"false"` ga QOTIRGAN
# (bu qator compose'da e'tiborsiz) — seed faqat alohida: `docker compose --profile init run --rm seed`.
App__SeedOnStartup=false

# --- Natija va AI (ixtiyoriy — compose standartlari xavfsiz) ------------------------------
# GLOBAL kill-switch: `false` — butun tizimda natijani o'quvchiga ko'rsatishni darhol yopadi.
App__ShowResultToStudent=true
# `true` — sessiya yakunlanishi bilan AI tahlili avtomatik navbatga qo'yiladi (XARAJAT!).
# Standart `false`: tahlil admin paneldagi tugma bilan qo'lda (`docs/13` §6.1).
Ai__AutoAnalyzeOnCompletion=false

# --- Telegram orqali kirish (P47) -------------------------------------------------------
# @BotFather bergan bot tokeni (`123456789:AA...`) — SIR. Faqat Login Widget imzosini
# tekshiradi. BO'SH bo'lsa Telegram kirishi o'chiq (`503 TELEGRAM_AUTH_NOT_CONFIGURED`),
# qolgan oqimlar ishlaydi. Bot @BotFather'da `/setdomain` bilan `16shaxsiyat.uz` ga bog'langan
# bo'lishi SHART.
Telegram__BotToken=
# Frontend'dagi bot nomi (`@`siz, SIR EMAS) — `app` image'ini BUILD qilishda bundle'ga yoziladi.
# Berilmasa compose standarti: `shaxsiyat16_bot`. O'zgartirilsa: `docker compose build app`.
# VITE_TELEGRAM_BOT=shaxsiyat16_bot

# --- Cloudflare tunnel (`tunnel` servisi, `--profile tunnel`) ---------------------------
# Zero Trust > Networks > Tunnels > (tunnel) > Configure > Install connector dagi token. SIR.
# Ingress (Public Hostname) Cloudflare panelida: `16shaxsiyat.uz` → `http://app:8080`.
# DIQQAT: shu token bilan ishlayotgan BOSHQA konnektor (eski mashina) to'xtatilishi kerak —
# aks holda trafik ikki mashina orasida bo'linadi (`docs/13` §13.6).
TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# --- Host porti (`app` servisi) -----------------------------------------------------------
# `app` (nginx) host'da `127.0.0.1:${WEB_PORT}` ga chiqariladi — FAQAT diagnostika uchun
# (`curl http://127.0.0.1:8090/health`). Tunnel bu portdan FOYDALANMAYDI: ingress
# `http://app:8080` docker ichki tarmog'idagi konteyner porti. Standart 8090; host'da 8080
# ATAYLAB ishlatilmaydi (boshqa servislar bilan to'qnashmaslik uchun). Port band bo'lsa —
# bo'sh portni tanlang (`ss -ltn | grep :8090` bilan tekshiring) va `docker compose up -d app`.
WEB_PORT=8090

# Ixtiyoriy: `Production` (standart). `Development` — Swagger ochiladi, Mock AI provayder
# ulanadi: serverda HECH QACHON.
# ASPNETCORE_ENVIRONMENT=Production

# --- E2E testlar (faqat dasturchi mashinasi/CI; serverda KERAK EMAS) -------------------
# `docker-compose.e2e.yml` alohida bir martalik stek ko'taradi, jonli bazaga tegmaydi.
# Jonli `ADMIN_PASSWORD` dan FARQLI bo'lsin.
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=CHANGE_ME_E2E_ONLY_PASSWORD
# E2E_WEB_PORT=5199
# E2E_API_PORT=5081
