# BO'SH = "same-origin" (tavsiya): so'rovlar `/api/...` nisbiy yo'li bilan ketadi — dev'da
# Vite proksisi (`vite.config.ts`, `DEV_API_PROXY_TARGET`), Docker'da nginx uzatadi.
# Mutlaq manzil (masalan `http://localhost:5000`) HTTPS domenda mixed content bilan
# bloklanadi (`src/shared/config/env.ts` izohi). Docker build bu faylni umuman o'qimaydi.
VITE_API_BASE_URL=
VITE_APP_NAME=Shaxsiyat
# Telegram Login Widget uchun bot nomi (`@`siz). Bo'sh qoldirilsa `/kirish` sahifasi
# "Telegram kirishi hozircha sozlanmagan" holatini ko'rsatadi (oq ekran emas).
# Bot BotFather'da `/setdomain` bilan sayt domeniga bog'langan bo'lishi SHART.
VITE_TELEGRAM_BOT=
VITE_SENTRY_DSN=
