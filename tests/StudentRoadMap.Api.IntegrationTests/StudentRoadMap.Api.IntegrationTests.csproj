<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      Docker/PostgreSQL bu muhitda yo'q (`prompts/10`) — `PublicApiTestFactory` `AppDbContext`ni
      SQLite in-memory bilan almashtiradi (`tests/StudentRoadMap.Infrastructure.Tests`dagi
      `SqliteAppDbContextFactory` naqshiga mos).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <!-- Transitiv `SQLitePCLRaw.lib.e_sqlite3` 2.1.10 NU1903 (yuqori darajali zaiflik) beradi — aniq yangi versiya bilan qulflaymiz. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- `prompts/27` MAXSUS DIQQAT (tekshiruv): eksport testlari haqiqiy fayl baytlarini
         tekshiradi — `.xlsx` `ClosedXML` bilan qayta ochilib (parse qilinib) tasdiqlanadi. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudentRoadMap.Api\StudentRoadMap.Api.csproj" />
  </ItemGroup>

  <!--
    P52 (`docs/18` §5/§7): "Import (JSON)" qabul mezoni — `docs/examples/sorovnoma-intellect.json`
    o'zgartirilmaydigan kirish (o'zgarmas fayl, `docs/18` chegarasi) — chiqish katalogiga
    nusxalanadi, shu bilan test uni HTTP orqali import qilib, nashr qilib sinaydi.
  -->
  <ItemGroup>
    <Content Include="..\..\docs\examples\sorovnoma-intellect.json">
      <Link>examples\sorovnoma-intellect.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>